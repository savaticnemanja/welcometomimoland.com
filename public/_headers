# Cache policy for hosts that read this file (Cloudflare Pages, Netlify).
#
# NOTE: it is NOT read on the current host. welcometomimoland.com serves from
# nginx behind the Cloudflare proxy, which ignores _headers entirely — the
# videos come back with `max-age=14400` and the HTML with no Cache-Control at
# all, neither of which is what this file says. The equivalent server config is
# in deploy/cache.conf; apply that, or move the site to a host that reads this.

# Content-hashed by the build — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Filenames embed the rendition width and change when the image does.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# The hero loop. Much the largest asset on the site, so a repeat visitor
# refetching it is the single most expensive cache miss available.
/video/*
  Cache-Control: public, max-age=31536000, immutable

# The email lockup. Not content-hashed, and already-delivered mail points at
# this URL forever, so `immutable` would pin an old logo into every mail
# client's cache. A week is long enough to stop refetching on each open.
/email/*
  Cache-Control: public, max-age=604800

# HTML must revalidate so deploys are picked up immediately.
/*
  Cache-Control: public, max-age=0, must-revalidate
